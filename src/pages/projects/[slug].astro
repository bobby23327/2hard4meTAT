---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import Icon from '../../components/Icon.astro';
import { tracks, statusLabels } from '../../data/tracks';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const track = tracks.find((track) => track.id === project.data.track);
if (!track) throw new Error(`Unknown project track: ${project.data.track}`);
const articles = new Map((await getCollection('blog')).map((post) => [post.id, post]));
const posts = project.data.relatedPosts.map((id) => {
  const post = articles.get(id);
  if (!post) throw new Error(`Project ${project.id} references an unknown article: ${id}`);
  return post;
});
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  image={project.data.cover}
  article
>
  <div class="container case-page">
    <a class="back-link" href="/projects/">← 返回项目</a>
    <header class="case-header">
      <div class="eyebrow">{track.english} <span class="eyebrow-separator">/</span> CASE STUDY</div><h1>
        {project.data.title}<span class="accent">.</span>
      </h1><p class="case-subtitle">{project.data.subtitle}</p><p class="case-description">
        {project.data.description}
      </p><div class="case-metadata">
        <div>
          <span class="metadata-label">项目状态</span><span
            class:list={['project-status', project.data.status]}
            ><i></i>{statusLabels[project.data.status]}</span
          >
        </div><div>
          <span class="metadata-label">技术栈</span><div class="tags">
            {
              project.data.tags.map((tag) => (
                <a class="tag" href={`/projects/?tag=${encodeURIComponent(tag)}`}>
                  {tag}
                </a>
              ))
            }
          </div>
        </div><div>
          <span class="metadata-label">方向</span><a
            class="text-link"
            href={`/projects/?track=${project.data.track}`}>{track.label} ↗</a
          >
        </div>
      </div>
    </header>
    <MediaGallery media={project.data.media} title={project.data.title} />
    <div class="reading-layout">
      <article class="prose" data-article>
        <Content /><section class="project-resources">
          <h2 id="resources">项目资源</h2><div class="resource-links">
            {
              project.data.github && (
                <a
                  class="button secondary"
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="github" size={18} /> GitHub 源码
                </a>
              )
            }{
              project.data.demo && (
                <a class="button primary" href={project.data.demo} target="_blank" rel="noopener noreferrer">
                  运行 Demo <Icon name="external" size={18} />
                </a>
              )
            }{!project.data.github && !project.data.demo && <p>公开仓库与演示资料整理后将在这里补充。</p>}
          </div>
        </section>{
          posts.length > 0 && (
            <section class="related-reading">
              <h2 id="related-reading">延伸阅读</h2>
              {posts.map((post) => (
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                  <span>↗</span>
                </a>
              ))}
            </section>
          )
        }
      </article><TableOfContents headings={headings} />
    </div>
    <a class="end-link" href="/projects/"
      ><span class="eyebrow">KEEP EXPLORING</span><span>继续探索项目 <Icon name="arrow" size={26} /></span></a
    >
  </div>
  <script>
    import '../../scripts/reading';
    import '../../scripts/gallery';
  </script>
</BaseLayout>
