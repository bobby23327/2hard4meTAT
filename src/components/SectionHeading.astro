---
import { withBase } from '../lib/urls';
interface Props {
  index: string;
  title: string;
  english: string;
  href?: string;
  linkText?: string;
}
const { index, title, english, href, linkText = '查看全部' } = Astro.props;
---

<div class="section-heading">
  <div class="section-title">
    <span class="section-index">{index}</span><h2>{title}</h2><span class="section-english">{english}</span>
  </div>{
    href && (
      <a class="text-link" href={withBase(href)}>
        {linkText}
        <span aria-hidden="true">↗</span>
      </a>
    )
  }
</div>
