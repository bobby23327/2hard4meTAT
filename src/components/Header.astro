---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
const links = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/blog/', label: '技术札记' },
  { href: '/about/', label: '关于' },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-bar">
    <a class="brand" href="/" aria-label={`${profile.name}，首页`}
      ><span class="brand-symbol" aria-hidden="true">[<i></i>]</span><span
        >{profile.name}<span class="brand-sub">{profile.brandEnglish}</span></span
      ></a
    >
    <nav id="main-navigation" aria-label="主导航">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={(href === '/' ? pathname === '/' : pathname.startsWith(href)) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <button class="icon-button theme-toggle" type="button" aria-label="切换到浅色主题" title="切换主题"
        ><span class="theme-sun"><Icon name="sun" /></span><span class="theme-moon"><Icon name="moon" /></span
        ></button
      >
      <a class="nav-contact" href="/about/#contact">认识一下 <Icon name="external" size={16} /></a>
      <button
        class="icon-button menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-navigation"
        aria-label="展开导航"><Icon name="menu" /></button
      >
    </div>
  </div>
</header>
