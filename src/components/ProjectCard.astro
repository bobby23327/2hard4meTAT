---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { statusLabels } from '../data/tracks';
interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  filterable?: boolean;
}
const { project, index = 0, filterable = false } = Astro.props;
const { data, id } = project;
---

<article
  class="project-card"
  data-filter-item={filterable || undefined}
  data-track={data.track}
  data-tags={JSON.stringify(data.tags)}
  data-search={`${data.title} ${data.subtitle} ${data.description} ${data.tags.join(' ')}`}
  data-featured={data.featured ? '1' : '0'}
  data-order={data.order}
>
  <a class="project-cover" href={`/projects/${id}/`} tabindex="-1" aria-hidden="true">
    <img src={data.cover} alt="" width="1200" height="750" loading="lazy" decoding="async" />
    {data.coverKind === 'concept' && <span class="cover-note">概念示意</span>}
    <span class="cover-arrow"><Icon name="external" /></span>
  </a>
  <div class="project-meta">
    <span class="mono"
      >0{index + 1} / {
        data.track === 'game'
          ? 'GAME DEVELOPMENT'
          : data.track === 'engine'
            ? 'ENGINE & TOOLS'
            : 'AGENT INFRASTRUCTURE'
      }</span
    ><span class:list={['project-status', data.status]}><i></i>{statusLabels[data.status]}</span>
  </div>
  <h3><a href={`/projects/${id}/`}>{data.title}<Icon name="external" size={20} /></a></h3>
  <p>{data.description}</p>
  <div class="tags">
    {
      data.tags.slice(0, 3).map((tag) => (
        <a
          class="tag"
          href={`/projects/?tag=${encodeURIComponent(tag)}`}
          data-project-tag={filterable ? tag : undefined}
        >
          {tag}
        </a>
      ))
    }
  </div>
</article>
