---
import { withBase } from '../lib/urls';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title = profile.title,
  description = `${profile.university}${profile.major}专业 ${profile.graduation} 届${profile.degree}生的项目作品集与工程札记。${profile.description}`,
  image = '/images/social-card.png',
  article = false,
  noindex = false,
} = Astro.props;
const site = Astro.site;
if (!site) throw new Error('Page metadata requires a configured site origin.');
const canonicalPath = Astro.url.pathname.endsWith('/404/') ? '/404.html' : Astro.url.pathname;
const canonical = new URL(withBase(canonicalPath), site);
const socialImage = withBase(image.endsWith('.svg') ? '/images/social-card.png' : image);
const localSite = ['localhost', '127.0.0.1'].includes(site.hostname);
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {profile.name}</title><meta name="description" content={description} />
    <meta name="theme-color" content="#111315" /><meta name="color-scheme" content="dark light" />
    {(noindex || localSite) && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} /><link
      rel="canonical"
      href={canonical}
    />
    <meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content={profile.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} /><meta
      property="og:title"
      content={`${title} · ${profile.name}`}
    />
    <meta property="og:description" content={description} /><meta
      property="og:url"
      content={canonical}
    /><meta property="og:image" content={new URL(socialImage, site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} RSS`}
      href={withBase('/rss.xml')}
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('portfolio-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (error) {
        if (!(error instanceof DOMException)) throw error;
      }
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header /><main id="main-content"><slot /></main><Footer />
    <div id="ui-announcement" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
